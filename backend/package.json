{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.plan.prisma && prisma generate --schema=prisma/schema.ejec.prisma",
    "db:push": "prisma db push --schema=prisma/schema.plan.prisma && prisma db push --schema=prisma/schema.ejec.prisma",
    "db:migrate:plan": "prisma migrate dev --schema=prisma/schema.plan.prisma",
    "db:migrate:ejec": "prisma migrate dev --schema=prisma/schema.ejec.prisma",
    "db:pull": "prisma db pull --schema=prisma/schema.plan.prisma && prisma db pull --schema=prisma/schema.ejec.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio:plan": "prisma studio --schema=prisma/schema.plan.prisma",
    "db:studio:ejec": "prisma studio --schema=prisma/schema.ejec.prisma --port 5556"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
