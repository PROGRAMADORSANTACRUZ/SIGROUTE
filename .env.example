# ============================================================
# SigRoute — variables de entorno para producción (Dokploy)
# Copia estas claves en el panel de Environment de Dokploy.
# NO subas el archivo .env real al repositorio.
# ============================================================

NODE_ENV=production
PORT=4000

# CORS / dominio público
CORS_ORIGIN="https://sigroute.grupo-santacruz.com"

# Base de datos Postgres única (Planeación + Ejecución ya migradas y
# unificadas en la misma BD). Si vuelven a aparecer errores "Timed out
# fetching a new connection from the connection pool" (P2024) en los logs,
# subir connection_limit (la BD dedicada de este proyecto soporta más —
# ver notas de incidentes anteriores) — este cambio hay que aplicarlo en
# Dokploy (variable real de producción), este archivo es solo plantilla.
DATABASE_URL_PLAN="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/rutas?connection_limit=15&pool_timeout=20"

# Firma de la cookie de sesión (cadena larga y aleatoria)
SECRET_KEY="cambia-esto-por-un-secreto-largo-y-aleatorio"
# En producción (HTTPS detrás de Traefik) debe ir en true.
SESSION_HTTPS_ONLY=true

# SSO Suite Santacruz (inicio de sesión por ticket)
SSO_ISSUER_URL="https://suite.grupo-santacruz.com"
SSO_SHARED_SECRET=""
SSO_TIMEOUT_MS=7000

# Integración Drivin
DRIVIN_API_URL="https://external.driv.in/api/external"
DRIVIN_API_KEY=""

# Integraciones Grupo Santacruz (apiconsulta / SIGCOM)
# Token de apiconsulta (mismo que PRICE_LISTS_TOKEN de SIGCOM). Se envía como ?token=
CLIENTES_TAT_TOKEN=""
TAT_INVOICES_URL="https://sigcom.grupo-santacruz.com/api/public/dispatch/tat-invoices?cia={cia}"
# Token de la API pública de despacho de SIGCOM (DISPATCH_API_TOKEN). Se envía como x-api-key.
TAT_INVOICES_TOKEN=""
# Consulta directa a apiconsulta (Siesa) por factura (mismo token de arriba).
FACTURAS_AGRO_URL="https://apiconsulta.grupo-santacruz.com/ventas/facturas-agropecuaria-tat"
FACTURAS_INV_URL="https://apiconsulta.grupo-santacruz.com/ventas/facturas-tat-inversiones"

# Google Maps Platform (Geocoding API + Maps JavaScript API, geozonas de rutas).
# Una sola key basta: el frontend la obtiene en runtime vía GET /api/config/maps-key
# (no hace falta NEXT_PUBLIC_*, ver frontend/src/lib/googleMaps.ts). Restringir
# por IP del servidor + dominio (HTTP referrers) en Google Cloud Console cuando
# se deje de usar la key de prueba.
GOOGLE_MAPS_API_KEY=""
